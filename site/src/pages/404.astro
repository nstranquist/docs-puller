---
import BaseLayout from "@/layouts/BaseLayout.astro"
---

<BaseLayout
  title="Not found"
  description="This docs-puller page does not exist."
  noindex
>
  <section
    class="section-wrap flex min-h-[62vh] flex-col items-center justify-center py-20 text-center"
  >
    <p class="text-primary font-mono text-sm font-semibold tracking-[.1em]">
      404 / NO MATCH
    </p>
    <h1
      class="font-heading mt-6 text-5xl font-semibold tracking-[-.055em] sm:text-7xl"
    >
      That page is not in the index.
    </h1>
    <p class="text-muted-foreground mt-6 max-w-md leading-relaxed">
      Return to the product page or put a real documentation query through the
      live engine.
    </p>
    <div class="mt-8 flex gap-3">
      <a
        href="/"
        class="border-border bg-background hover:bg-muted inline-flex h-11 items-center rounded-xl border px-4 text-sm font-semibold"
        >Go home</a
      >
      <a
        href="/demo/"
        class="bg-primary text-primary-foreground hover:bg-primary/88 inline-flex h-11 items-center rounded-xl px-4 text-sm font-semibold"
        >Open the demo</a
      >
    </div>
  </section>
</BaseLayout>
