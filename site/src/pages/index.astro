---
import BaseLayout from "@/layouts/BaseLayout.astro"

const proof = [
  { value: "95.8%", label: "Hit@1", note: "frozen public baseline" },
  { value: "100%", label: "Hit@5", note: "24 measured queries" },
  { value: "0.979", label: "MRR", note: "BM25 only" },
  { value: "<1 ms", label: "p50", note: "engine latency" },
]

const stages = [
  {
    number: "01",
    title: "Pull",
    body: "Mirror public documentation with stable URLs and manifests.",
  },
  {
    number: "02",
    title: "Normalize",
    body: "Turn provider pages into clean Markdown for humans and agents.",
  },
  {
    number: "03",
    title: "Index",
    body: "Build a portable SQLite FTS5 index with no external service.",
  },
  {
    number: "04",
    title: "Search",
    body: "Return cited snippets through the CLI, local API, or editor.",
  },
  {
    number: "05",
    title: "Evaluate",
    body: "Measure Hit@k, MRR, latency, drift, and regressions.",
  },
]
---

<BaseLayout
  title="docs-puller"
  description="Mirror documentation to Markdown, search it locally with SQLite FTS5, and give agents precise cited context. Try the real engine in a public live demo."
>
  <section
    class="relative overflow-hidden pt-20 pb-16 sm:pt-28 lg:pt-36 lg:pb-24"
  >
    <div class="page-grid pointer-events-none absolute inset-0 -z-10"></div>
    <div
      class="section-wrap grid items-center gap-16 lg:grid-cols-[1.03fr_.97fr] lg:gap-12"
    >
      <div>
        <p class="eyebrow">
          <span class="signal-dot"></span> Real engine · public sample
        </p>
        <h1 class="display-title mt-7">
          Search the docs.<br /><span class="text-primary"
            >Keep the context.</span
          >
        </h1>
        <p class="lede mt-8">
          Mirror documentation to Markdown. Index it with SQLite FTS5. Give
          people and agents precise, cited answers without a hosted search
          dependency.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href="/demo/"
            class="bg-primary text-primary-foreground hover:bg-primary/88 inline-flex h-12 items-center justify-center gap-2 rounded-xl px-5 text-[0.9375rem] font-semibold shadow-[0_12px_35px_color-mix(in_oklch,var(--primary),transparent_72%)] transition-all hover:-translate-y-0.5"
          >
            Search the live corpus
            <svg
              viewBox="0 0 24 24"
              class="size-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg
            >
          </a>
          <a
            href="https://github.com/nstranquist/docs-puller#quick-start"
            class="border-border bg-background/70 hover:border-primary/35 hover:bg-muted inline-flex h-12 items-center justify-center gap-2 rounded-xl border px-5 text-[0.9375rem] font-semibold transition-all hover:-translate-y-0.5"
          >
            Install the CLI
            <svg
              viewBox="0 0 24 24"
              class="size-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
              ><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 21h14"></path></svg
            >
          </a>
        </div>
        <div
          class="text-muted-foreground mt-8 flex flex-wrap gap-x-5 gap-y-2 font-mono text-[0.69rem] font-medium tracking-wide uppercase"
        >
          <span class="inline-flex items-center gap-1.5"
            ><span class="bg-primary size-1 rounded-full"></span>Pure Go</span
          >
          <span class="inline-flex items-center gap-1.5"
            ><span class="bg-primary size-1 rounded-full"
            ></span>Local-first</span
          >
          <span class="inline-flex items-center gap-1.5"
            ><span class="bg-primary size-1 rounded-full"
            ></span>Apache-2.0</span
          >
          <span class="inline-flex items-center gap-1.5"
            ><span class="bg-primary size-1 rounded-full"></span>Zero AI in this
            demo</span
          >
        </div>
      </div>

      <div class="relative lg:pl-4">
        <div
          class="bg-primary/9 absolute -inset-12 -z-10 rounded-full blur-3xl"
        >
        </div>
        <div
          class="terminal-shell rotate-[.35deg] transition-transform duration-500 hover:rotate-0"
        >
          <div class="terminal-chrome">
            <span class="flex items-center gap-1.5"
              ><i class="size-2 rounded-full bg-[#ff6b6b]"></i><i
                class="size-2 rounded-full bg-[#ffd166]"></i><i
                class="size-2 rounded-full bg-[#34d399]"></i></span
            >
            <span>docs-puller / search</span>
            <span class="text-emerald-400">fts5</span>
          </div>
          <div
            class="p-5 font-mono text-[0.74rem] leading-relaxed sm:p-7 sm:text-[0.79rem]"
          >
            <p>
              <span class="text-emerald-400">$</span>
              <span class="text-slate-300">docs-puller search</span>
            </p>
            <p class="mt-1 pl-4 text-cyan-300">
              "fts5 external content tables" --json
            </p>
            <div class="my-5 h-px bg-white/8"></div>
            <div class="space-y-1 text-slate-400">
              <p>{`{`}</p>
              <p class="pl-4">
                <span class="text-cyan-300">"mode"</span>: <span
                  class="text-emerald-300">"fts5"</span
                >,
              </p>
              <p class="pl-4">
                <span class="text-cyan-300">"elapsed_ms"</span>: <span
                  class="text-amber-200">1</span
                >,
              </p>
              <p class="pl-4">
                <span class="text-cyan-300">"results"</span>: [
              </p>
              <div
                class="my-2 ml-4 rounded-lg border border-white/8 bg-white/[.035] p-4 text-slate-300"
              >
                <p>
                  <span class="text-cyan-300">"title"</span>: <span
                    class="text-emerald-300">"SQLite FTS5 Extension"</span
                  >,
                </p>
                <p>
                  <span class="text-cyan-300">"source"</span>: <span
                    class="text-emerald-300">"sqlite"</span
                  >,
                </p>
                <p>
                  <span class="text-cyan-300">"path"</span>: <span
                    class="text-emerald-300">"fts5.md"</span
                  >
                </p>
              </div>
              <p class="pl-4">]</p>
              <p>{`}`}</p>
            </div>
          </div>
          <div
            class="flex items-center justify-between border-t border-white/8 px-5 py-3 font-mono text-[0.65rem] text-slate-500 sm:px-7"
          >
            <span>SQLite · Go · PostgreSQL</span>
            <span class="text-emerald-400">24 docs ready</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-rule">
    <div
      class="section-wrap divide-border/70 grid divide-y sm:grid-cols-2 sm:divide-x sm:divide-y-0 lg:grid-cols-4"
    >
      {
        proof.map((item) => (
          <a
            href="/method/#baseline"
            class="group px-2 py-8 first:pl-0 sm:px-7 lg:py-10"
          >
            <p class="metric-number group-hover:text-primary transition-colors">
              {item.value}
            </p>
            <p class="mt-2 text-sm font-semibold">{item.label}</p>
            <p class="text-muted-foreground mt-1 font-mono text-[0.66rem] uppercase">
              {item.note}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="py-24 sm:py-32">
    <div class="section-wrap">
      <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:gap-20">
        <div>
          <p class="eyebrow">One complete path</p>
          <h2 class="section-title mt-5">Docs in.<br />Context out.</h2>
          <p
            class="text-muted-foreground mt-6 max-w-md text-base leading-relaxed"
          >
            The engine owns the full retrieval loop, so its quality can be
            tested instead of assumed.
          </p>
        </div>
        <ol class="border-border/70 border-t">
          {
            stages.map((stage) => (
              <li class="group border-border/70 grid gap-3 border-b py-6 sm:grid-cols-[3rem_8rem_1fr] sm:items-baseline">
                <span class="text-primary font-mono text-[0.66rem] font-semibold">
                  {stage.number}
                </span>
                <h3 class="text-base font-semibold tracking-[-0.02em] transition-transform group-hover:translate-x-1">
                  {stage.title}
                </h3>
                <p class="text-muted-foreground max-w-xl text-sm leading-relaxed">
                  {stage.body}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section-rule py-24 sm:py-32">
    <div class="section-wrap">
      <div class="max-w-3xl">
        <p class="eyebrow">Built for the real work</p>
        <h2 class="section-title mt-5">
          Retrieval you can inspect, replay, and trust.
        </h2>
      </div>
      <div class="mt-14 grid gap-4 md:grid-cols-3">
        <article
          class="border-border/75 bg-card rounded-2xl border p-6 shadow-sm md:col-span-2 md:p-8"
        >
          <div
            class="bg-primary/10 text-primary flex size-10 items-center justify-center rounded-xl"
          >
            <svg
              viewBox="0 0 24 24"
              class="size-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
              ><path d="M4 5h16v14H4zM4 9h16M8 5v14"></path></svg
            >
          </div>
          <h3 class="mt-8 text-xl font-semibold tracking-[-0.035em]">
            Local by default
          </h3>
          <p class="text-muted-foreground mt-3 max-w-xl leading-relaxed">
            Your corpus stays on your machine as Markdown and one SQLite file.
            Search works offline, and the data shape stays portable.
          </p>
          <div class="mt-8 grid gap-3 sm:grid-cols-3">
            <div class="bg-muted/55 rounded-xl p-4">
              <p class="text-primary font-mono text-xs">01</p><p
                class="mt-4 text-sm font-semibold"
              >
                No daemon required
              </p>
            </div>
            <div class="bg-muted/55 rounded-xl p-4">
              <p class="text-primary font-mono text-xs">02</p><p
                class="mt-4 text-sm font-semibold"
              >
                No hosted index
              </p>
            </div>
            <div class="bg-muted/55 rounded-xl p-4">
              <p class="text-primary font-mono text-xs">03</p><p
                class="mt-4 text-sm font-semibold"
              >
                No data lock-in
              </p>
            </div>
          </div>
        </article>

        <article
          class="border-border/75 rounded-2xl border bg-[#101827] p-6 text-slate-100 shadow-sm md:p-8"
        >
          <div class="flex items-center justify-between">
            <div
              class="flex size-10 items-center justify-center rounded-xl bg-emerald-400/12 text-emerald-300"
            >
              <svg
                viewBox="0 0 24 24"
                class="size-5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"><path d="m5 12 4 4L19 6"></path></svg
              >
            </div>
            <span class="font-mono text-[0.65rem] text-emerald-300 uppercase"
              >Measured</span
            >
          </div>
          <h3 class="mt-8 text-xl font-semibold tracking-[-0.035em]">
            Quality gates included
          </h3>
          <p class="mt-3 leading-relaxed text-slate-400">
            Frozen fixtures turn retrieval changes into visible Hit@k, MRR,
            latency, and drift decisions.
          </p>
          <a
            href="/method/#baseline"
            class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-emerald-300 hover:text-emerald-200"
            >Read the method <span aria-hidden="true">→</span></a
          >
        </article>

        <article
          class="border-border/75 bg-card rounded-2xl border p-6 shadow-sm md:p-8"
        >
          <div
            class="bg-primary/10 text-primary flex size-10 items-center justify-center rounded-xl"
          >
            <svg
              viewBox="0 0 24 24"
              class="size-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
              ><path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5"></path></svg
            >
          </div>
          <h3 class="mt-8 text-xl font-semibold tracking-[-0.035em]">
            Agent-ready output
          </h3>
          <p class="text-muted-foreground mt-3 leading-relaxed">
            Stable JSON, cited snippets, source filters, and bounded results
            keep prompts compact and useful.
          </p>
        </article>

        <article
          class="border-primary/18 bg-primary/[.065] rounded-2xl border p-6 shadow-sm md:col-span-2 md:p-8"
        >
          <div class="grid gap-8 sm:grid-cols-[1fr_auto] sm:items-end">
            <div>
              <div
                class="bg-primary/12 text-primary flex size-10 items-center justify-center rounded-xl"
              >
                <svg
                  viewBox="0 0 24 24"
                  class="size-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  aria-hidden="true"
                  ><path d="M12 3 4 7v5c0 5 3.4 8.5 8 9 4.6-.5 8-4 8-9V7l-8-4Z"
                  ></path><path d="m9 12 2 2 4-4"></path></svg
                >
              </div>
              <h3 class="mt-8 text-xl font-semibold tracking-[-0.035em]">
                The public demo has a hard boundary
              </h3>
              <p class="text-muted-foreground mt-3 max-w-2xl leading-relaxed">
                It uses 24 reviewed public pages. It sends no cookie, account,
                browser token, or local path. Aggregate runtime counts never
                contain your raw query.
              </p>
            </div>
            <a
              href="/method/#privacy"
              class="text-primary text-sm font-semibold hover:underline hover:underline-offset-4"
              >Inspect the boundary →</a
            >
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-28">
    <div class="section-wrap">
      <div
        class="relative overflow-hidden rounded-[2rem] bg-[#101827] px-6 py-14 text-slate-100 sm:px-12 sm:py-16 lg:px-16"
      >
        <div class="page-grid pointer-events-none absolute inset-0 opacity-55">
        </div>
        <div class="relative grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <p class="eyebrow text-emerald-300">No install needed</p>
            <h2
              class="font-heading mt-5 max-w-3xl text-[clamp(2.3rem,6vw,5rem)] leading-[.96] font-semibold tracking-[-.055em]"
            >
              Put the real engine under your own question.
            </h2>
            <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-400">
              Search SQLite, Go, and PostgreSQL docs in the browser. Then
              reproduce the same query with the open CLI.
            </p>
          </div>
          <a
            href="/demo/"
            class="inline-flex h-12 shrink-0 items-center justify-center gap-2 rounded-xl bg-emerald-400 px-5 text-sm font-semibold text-[#101827] transition-transform hover:-translate-y-0.5 hover:bg-emerald-300"
            >Open the live demo <span aria-hidden="true">→</span></a
          >
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
