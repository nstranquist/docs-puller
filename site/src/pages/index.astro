---
import BaseLayout from "@/layouts/BaseLayout.astro"

const proof = [
  { value: "95.8%", label: "Hit@1", note: "frozen public baseline" },
  { value: "100%", label: "Hit@5", note: "24 measured queries" },
  { value: "0.979", label: "MRR", note: "BM25 only" },
  { value: "<1 ms", label: "p50", note: "engine latency" },
]

const stages = [
  {
    number: "01",
    title: "Pull",
    body: "Mirror public documentation with stable URLs and manifests.",
  },
  {
    number: "02",
    title: "Normalize",
    body: "Turn provider pages into clean Markdown for humans and agents.",
  },
  {
    number: "03",
    title: "Index",
    body: "Build a portable SQLite FTS5 index with no external service.",
  },
  {
    number: "04",
    title: "Search",
    body: "Return cited snippets through the CLI, local API, or editor.",
  },
  {
    number: "05",
    title: "Evaluate",
    body: "Measure Hit@k, MRR, latency, drift, and regressions.",
  },
]

const constraints = [
  {
    title: "Local by default",
    body: "Your corpus stays on your machine as Markdown and one SQLite file. Search works offline, and the data shape stays portable. No daemon required, no hosted index, no data lock-in.",
  },
  {
    title: "Measured quality",
    body: "Frozen fixtures turn retrieval changes into visible Hit@k, MRR, latency, and drift decisions.",
    link: { href: "/method/#baseline", label: "Read the method" },
  },
  {
    title: "Agent-ready output",
    body: "Stable JSON, cited snippets, source filters, and bounded results keep prompts compact and useful.",
  },
  {
    title: "The public demo has a hard boundary",
    body: "It uses 24 reviewed public pages. It sends no cookie, account, browser token, or local path. Aggregate runtime counts never contain your raw query.",
    link: { href: "/method/#privacy", label: "Inspect the boundary" },
  },
]
---

<BaseLayout
  title="docs-puller"
  description="Mirror documentation to Markdown, search it locally with SQLite FTS5, and give agents precise cited context. Try the real engine in a public live demo."
>
  <section class="pt-16 pb-14 sm:pt-24 lg:pt-28 lg:pb-20">
    <div
      class="section-wrap grid items-center gap-14 lg:grid-cols-[1.03fr_.97fr] lg:gap-12"
    >
      <div>
        <h1 class="display-title">Local-first search for documentation</h1>
        <p class="lede mt-6">
          docs-puller mirrors documentation to Markdown and indexes it with
          SQLite FTS5, so people and agents get precise, cited answers without a
          hosted search dependency.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href="/demo/"
            class="bg-primary text-primary-foreground hover:bg-primary/88 inline-flex h-11 items-center justify-center gap-2 rounded-lg px-5 text-[0.9375rem] font-semibold transition-colors"
          >
            Search the live corpus
            <svg
              viewBox="0 0 24 24"
              class="size-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg
            >
          </a>
          <a
            href="https://github.com/nstranquist/docs-puller#quick-start"
            class="border-border bg-background hover:bg-muted inline-flex h-11 items-center justify-center gap-2 rounded-lg border px-5 text-[0.9375rem] font-semibold transition-colors"
          >
            Install the CLI
            <svg
              viewBox="0 0 24 24"
              class="size-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
              ><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 21h14"></path></svg
            >
          </a>
        </div>
        <p
          class="text-muted-foreground mt-7 font-mono text-[0.7rem] tracking-wide"
        >
          Pure Go · Local-first · Apache-2.0 · Zero AI in this demo
        </p>
      </div>

      <div class="lg:pl-4">
        <div class="terminal-shell">
          <div class="terminal-chrome">
            <span class="flex items-center gap-1.5"
              ><i class="size-2 rounded-full bg-[#ff6b6b]"></i><i
                class="size-2 rounded-full bg-[#ffd166]"></i><i
                class="size-2 rounded-full bg-[#34d399]"></i></span
            >
            <span>docs-puller / search</span>
            <span class="text-emerald-400">fts5</span>
          </div>
          <div
            class="p-5 font-mono text-[0.74rem] leading-relaxed sm:p-7 sm:text-[0.79rem]"
          >
            <p>
              <span class="text-emerald-400">$</span>
              <span class="text-slate-300">docs-puller search</span>
            </p>
            <p class="mt-1 pl-4 text-cyan-300">
              "fts5 external content tables" --json
            </p>
            <div class="my-5 h-px bg-white/8"></div>
            <div class="space-y-1 text-slate-400">
              <p>{`{`}</p>
              <p class="pl-4">
                <span class="text-cyan-300">"mode"</span>: <span
                  class="text-emerald-300">"fts5"</span
                >,
              </p>
              <p class="pl-4">
                <span class="text-cyan-300">"elapsed_ms"</span>: <span
                  class="text-amber-200">1</span
                >,
              </p>
              <p class="pl-4">
                <span class="text-cyan-300">"results"</span>: [
              </p>
              <div
                class="my-2 ml-4 rounded-lg border border-white/8 bg-white/[.035] p-4 text-slate-300"
              >
                <p>
                  <span class="text-cyan-300">"title"</span>: <span
                    class="text-emerald-300">"SQLite FTS5 Extension"</span
                  >,
                </p>
                <p>
                  <span class="text-cyan-300">"source"</span>: <span
                    class="text-emerald-300">"sqlite"</span
                  >,
                </p>
                <p>
                  <span class="text-cyan-300">"path"</span>: <span
                    class="text-emerald-300">"fts5.md"</span
                  >
                </p>
              </div>
              <p class="pl-4">]</p>
              <p>{`}`}</p>
            </div>
          </div>
          <div
            class="flex items-center justify-between border-t border-white/8 px-5 py-3 font-mono text-[0.65rem] text-slate-500 sm:px-7"
          >
            <span>SQLite · Go · PostgreSQL</span>
            <span class="text-emerald-400">24 docs ready</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-rule">
    <div
      class="section-wrap divide-border/70 grid divide-y sm:grid-cols-2 sm:divide-x sm:divide-y-0 lg:grid-cols-4"
    >
      {
        proof.map((item) => (
          <a
            href="/method/#baseline"
            class="group px-2 py-8 first:pl-0 sm:px-7 lg:py-10"
          >
            <p class="metric-number">{item.value}</p>
            <p class="mt-2 text-sm font-semibold">{item.label}</p>
            <p class="text-muted-foreground mt-1 font-mono text-[0.66rem] uppercase">
              {item.note}
            </p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="py-20 sm:py-24">
    <div class="section-wrap">
      <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:gap-20">
        <div>
          <h2 class="section-title">How it works</h2>
          <p
            class="text-muted-foreground mt-5 max-w-md text-base leading-relaxed"
          >
            The engine owns the full retrieval loop, so its quality can be
            tested instead of assumed.
          </p>
        </div>
        <ol class="border-border/70 border-t">
          {
            stages.map((stage) => (
              <li class="border-border/70 grid gap-3 border-b py-6 sm:grid-cols-[3rem_8rem_1fr] sm:items-baseline">
                <span class="text-muted-foreground font-mono text-[0.66rem] font-semibold">
                  {stage.number}
                </span>
                <h3 class="text-base font-semibold tracking-[-0.02em]">
                  {stage.title}
                </h3>
                <p class="text-muted-foreground max-w-xl text-sm leading-relaxed">
                  {stage.body}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section-rule py-20 sm:py-24">
    <div class="section-wrap">
      <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:gap-20">
        <div>
          <h2 class="section-title">Design constraints</h2>
          <p
            class="text-muted-foreground mt-5 max-w-md text-base leading-relaxed"
          >
            The properties the engine is built to keep, stated plainly enough to
            check.
          </p>
        </div>
        <div class="border-border/70 border-t">
          {
            constraints.map((item) => (
              <div class="border-border/70 border-b py-6">
                <h3 class="text-base font-semibold tracking-[-0.02em]">
                  {item.title}
                </h3>
                <p class="text-muted-foreground mt-2 max-w-xl text-sm leading-relaxed">
                  {item.body}
                </p>
                {item.link && (
                  <a
                    href={item.link.href}
                    class="text-primary mt-3 inline-flex items-center gap-2 text-sm font-semibold hover:underline hover:underline-offset-4"
                  >
                    {item.link.label} <span aria-hidden="true">→</span>
                  </a>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section-rule py-20 sm:py-24">
    <div class="section-wrap">
      <h2 class="section-title">Run the demo</h2>
      <p class="text-muted-foreground mt-5 max-w-2xl leading-relaxed">
        Search SQLite, Go, and PostgreSQL docs in the browser with the real
        engine. Then reproduce the same query with the open CLI.
      </p>
      <a
        href="/demo/"
        class="bg-primary text-primary-foreground hover:bg-primary/88 mt-8 inline-flex h-11 items-center justify-center gap-2 rounded-lg px-5 text-[0.9375rem] font-semibold transition-colors"
        >Open the live demo <span aria-hidden="true">→</span></a
      >
    </div>
  </section>
</BaseLayout>
