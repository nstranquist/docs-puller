    "config",
    "crawl-refs",
    "curation",
    "demo",
    "embed",
    "emit-llmstxt",
    "eval",
    "eval-diagnose",
    "eval-leaderboard",
    "eval-suite",
    "eval-sweep",
    "extract",
    "help",
    "init",
    "list",
    "log",
    "pdf-doctor",
    "pins",
    "profile",
    "pull",
    "pull-article",
    "pull-local-batch",
    "pull-pdf",
    "pull-pins",
    "pull-url",
